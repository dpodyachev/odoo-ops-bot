# .env — только то, что относится к самому боту и доступу. Серверы и /backup — в targets.json.
# Токен бота от @BotFather (свой на каждого клиента; не токен Claude-канала)
MONITOR_BOT_TOKEN=
# Кому бот отвечает (chat_id через запятую; группы — отрицательные)
ALLOWED_CHAT_IDS=
# Язык: DEFAULT_LANG (ru|uk) для всех чатов; UK_CHAT_IDS — чаты, где всегда украинский
DEFAULT_LANG=ru
UK_CHAT_IDS=
# Название в /help
BOT_TITLE=Odoo
# /backup разрешён только из этих чатов (пусто — ни из каких); режим и параметры — targets.json → backup
BACKUP_CHAT_IDS=
# /pull /update /restore разрешены только из этих чатов; пусто — те же, что BACKUP_CHAT_IDS
ADMIN_CHAT_IDS=
SSH_KEY=/root/.ssh/id_ed25519
# Модель для /analyze; пусто — модель Claude Code по умолчанию
CLAUDE_MODEL=
# Порог предупреждения по диску, %
DISK_WARN_PCT=85
# В Docker: токен Claude из `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=
